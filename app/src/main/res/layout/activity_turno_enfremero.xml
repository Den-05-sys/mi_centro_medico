<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cm_fondo"
    android:orientation="vertical"
    tools:context=".Turno_enfremero">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="96dp">

                <!-- Encabezado: Título, Subtítulo y Botón de Salida -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/btnCerrarSesion"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTituloTurno"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Turno Mañana"
                            android:textColor="#1A1C1E"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSubtituloEnfermero"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Carlos Ruiz · Enfermero"
                            android:textColor="@color/cm_texto_secundario"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnCerrarSesion"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Cerrar sesión"
                        android:focusable="true"
                        android:src="@drawable/ic_logout" />
                </RelativeLayout>

                <!-- Tarjetas de Resumen superior (Pacientes asignados y Registros hechos) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Tarjeta: Pacientes asignados -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPacientesAsignados"
                        style="@style/Widget.Material3.CardView.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="#E0E0E0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tvCantPacientes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1"
                                android:textColor="#1A1C1E"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Pacientes asignados"
                                android:textColor="@color/cm_texto_secundario"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Tarjeta: Registros hechos -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardRegistrosHechos"
                        style="@style/Widget.Material3.CardView.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="#E0E0E0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tvCantRegistros"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#1A1C1E"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Registros hechos"
                                android:textColor="@color/cm_texto_secundario"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Título de Sección -->
                <TextView
                    android:id="@+id/tvSeccionPacientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:letterSpacing="0.03"
                    android:text="PACIENTES DEL TURNO"
                    android:textColor="#4A4A4A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Tarjeta de Paciente -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPacienteItem"
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Fila con Avatar, Info de paciente y Badge "Pendiente" -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <!-- Circle Avatar "JP" -->
                            <TextView
                                android:id="@+id/tvAvatarPaciente"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/bg_avatar"
                                android:gravity="center"
                                android:text="JP"
                                android:textColor="#13382C"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <!-- Nombre e Historia Clínica -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="12dp"
                                android:layout_toStartOf="@id/tvBadgeEstado"
                                android:layout_toEndOf="@id/tvAvatarPaciente"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvNombrePaciente"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Juan Pérez"
                                    android:textColor="#1A1C1E"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvInfoPaciente"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="HC-2024-001 · 55 años"
                                    android:textColor="@color/cm_texto_secundario"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <!-- Tag / Badge "Pendiente" -->
                            <TextView
                                android:id="@+id/tvBadgeEstado"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentTop="true"
                                android:background="@drawable/bg_badge_pendiente"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="Pendiente"
                                android:textColor="@color/cm_badge_pendiente_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- Detalle de consulta -->
                        <TextView
                            android:id="@+id/tvDetalleConsulta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Consulta 2025-09-10 · Dra. Laura Gómez · Dolor en el pecho"
                            android:textColor="#444444"
                            android:textSize="13sp" />

                        <!-- Botones de Acción: Signos y Medicar -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSignos"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:textAllCaps="false"
                                android:textColor="#1A1C1E"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:text="Signos"
                                app:cornerRadius="20dp"
                                app:icon="@drawable/ic_pulse"
                                app:iconGravity="textStart"
                                app:iconPadding="8dp"
                                app:iconTint="#1A1C1E"
                                app:strokeColor="#5F6368" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMedicar"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:textAllCaps="false"
                                android:textColor="#1A1C1E"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:text="Medicar"
                                app:cornerRadius="20dp"
                                app:icon="@drawable/ic_pill"
                                app:iconGravity="textStart"
                                app:iconPadding="8dp"
                                app:iconTint="#1A1C1E"
                                app:strokeColor="#5F6368" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_nav_enfermero"
        app:labelVisibilityMode="labeled" />
</LinearLayout>