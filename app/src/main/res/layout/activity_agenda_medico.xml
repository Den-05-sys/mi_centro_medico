<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cm_fondo"
    android:orientation="vertical"
    tools:context=".Agenda_medico">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/cm_fondo"
        app:navigationContentDescription="Volver"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:subtitle="Dra. Laura Gómez · Cardióloga"
        app:title="Agenda Médico"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/espacio_12"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="96dp"
                android:showDividers="middle">

                <!-- Selección de Paciente -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPaciente"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Paciente">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPaciente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false"
                        tools:text="Seleccione un paciente" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPacientes"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:visibility="gone"
                    tools:listitem="@layout/activity_paciente_item"
                    tools:visibility="visible" />

                <!-- Selección de Fecha -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilFecha"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Fecha"
                    app:endIconContentDescription="Fecha"
                    app:endIconDrawable="@drawable/ic_calendar"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFecha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="false"
                        android:inputType="date"
                        tools:text="2025-09-10" />
                </com.google.android.material.textfield.TextInputLayout>
                //En esta secion voy a cambiar la forma en que se visualiza la fecha para que quede en tarjetas y agregar un scroll view horizontal

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    //scroll_view horizontal para visualizar las targetas de los dias

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPacientesAsignados"
                        style="@style/Widget.Material3.CardView.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="#E0E0E0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tvCantPacientes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="lu 08"
                                android:textColor="#1A1C1E"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardRegistrosHechos"
                        style="@style/Widget.Material3.CardView.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="#E0E0E0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tvCantRegistros"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ma 9"
                                android:textColor="#1A1C1E"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                                        <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardRegistrosHechos"
                        style="@style/Widget.Material3.CardView.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="#E0E0E0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tvCantRegistros"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mi 10"
                                android:textColor="#1A1C1E"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                                        <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardRegistrosHechos"
                        style="@style/Widget.Material3.CardView.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="#E0E0E0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tvCantRegistros"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ju 11"
                                android:textColor="#1A1C1E"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                                        <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardRegistrosHechos"
                        style="@style/Widget.Material3.CardView.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="#E0E0E0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tvCantRegistros"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vi 12"
                                android:textColor="#1A1C1E"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Motivo de Consulta -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilMotivo"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Motivo de consulta">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMotivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        tools:text="Dolor en el pecho" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Tarjeta de Resumen -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardResumenCita"
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/espacio_8"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:showDividers="middle">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resumen"
                            android:textAllCaps="true"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="@color/cm_texto_secundario" />

                        <TextView
                            android:id="@+id/tvResumenCita"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            tools:text="Seleccione un paciente" />

                        <TextView
                            android:id="@+id/tvResumenFechaMotivo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/cm_texto_secundario"
                            tools:text="2025-09-10 · Dolor en el pecho" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

                <!-- Botón Iniciar Consulta -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIniciarConsulta"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Iniciar consulta"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_nav_medico" />
</LinearLayout>
