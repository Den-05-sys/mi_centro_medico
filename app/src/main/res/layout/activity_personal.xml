<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cm_fondo"
    android:orientation="vertical"
    tools:context=".Personal">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="96dp">



                <!-- Encabezado: Título, Subtítulo y Botón de Salida -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:id="@+id/linearLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <com.google.android.material.appbar.MaterialToolbar
                            android:id="@+id/toolbar"
                            android:layout_width="15dp"
                            android:layout_height="?attr/actionBarSize"
                            android:background="@color/cm_fondo"
                            app:navigationContentDescription="Volver"
                            app:navigationIcon="@drawable/ic_arrow_back"
                            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

                        <TextView
                            android:id="@+id/tvTituloTurno"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Personal"
                            android:textColor="#1A1C1E"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSubtituloEnfermero"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Clínica San Rafael · 3 empleados"
                            android:textColor="@color/cm_texto_secundario"
                            android:textSize="14sp" />
                    </LinearLayout>


                </RelativeLayout>

                <!-- Tabs (Todos | Enfermeros | Médicos) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnTodo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingVertical="8dp"
                            android:text="Todos"
                            android:textColor="#1E3A34"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:background="#1E3A34" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnEnfermeros"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingVertical="8dp"
                            android:text="Enfermeros"
                            android:textColor="#5F6368"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E0E0E0" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnMedicos"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingVertical="8dp"
                            android:text="Médicos"
                            android:textColor="#5F6368"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E0E0E0" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnAdministrativos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingVertical="8dp"
                    android:text="Administrativos"
                    android:textColor="#1E3A34"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Tarjeta de Empleados -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPacienteItem"
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Empleado 1: Laura Gómez -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/tvAvatarEmpleado1"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/bg_avatar"
                                android:gravity="center"
                                android:text="LG"
                                android:textColor="#13382C"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="12dp"
                                android:layout_toStartOf="@id/tvBadgeEstado1"
                                android:layout_toEndOf="@id/tvAvatarEmpleado1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvNombreEmpleado1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Laura Gómez"
                                    android:textColor="#1A1C1E"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvInfoEmpleado1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Médico · Cardióloga"
                                    android:textColor="@color/cm_texto_secundario"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvBadgeEstado1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentTop="true"
                                android:background="@drawable/bg_badge_pendiente"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="COL-98765"
                                android:textColor="@color/cm_badge_pendiente_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- Empleado 2: Carlos Ruiz -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">

                            <TextView
                                android:id="@+id/tvAvatarEmpleado2"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/bg_avatar"
                                android:gravity="center"
                                android:text="CR"
                                android:textColor="#13382C"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="12dp"
                                android:layout_toStartOf="@id/tvBadgeEstado2"
                                android:layout_toEndOf="@id/tvAvatarEmpleado2"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvNombreEmpleado2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Carlos Ruiz"
                                    android:textColor="#1A1C1E"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvInfoEmpleado2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Enfermero · Turno Mañana"
                                    android:textColor="@color/cm_texto_secundario"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvBadgeEstado2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentTop="true"
                                android:background="@drawable/bg_badge_pendiente"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="EMP-0002"
                                android:textColor="@color/cm_badge_pendiente_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- Empleado 3: María López -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">

                            <TextView
                                android:id="@+id/tvAvatarEmpleado3"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/bg_avatar"
                                android:gravity="center"
                                android:text="ML"
                                android:textColor="#13382C"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="12dp"
                                android:layout_toStartOf="@id/tvBadgeEstado3"
                                android:layout_toEndOf="@id/tvAvatarEmpleado3"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvNombreEmpleado3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="María López"
                                    android:textColor="#1A1C1E"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvInfoEmpleado3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Administrativo · Recepción"
                                    android:textColor="@color/cm_texto_secundario"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvBadgeEstado3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentTop="true"
                                android:background="@drawable/bg_badge_pendiente"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="EMP-0003"
                                android:textColor="@color/cm_badge_pendiente_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- Botón Contratar -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnContratar"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="20dp"
                            android:text="Contratar nuevo empleado"
                            android:textAllCaps="false"
                            android:textColor="#1A1C1E"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:cornerRadius="28dp"
                            app:icon="@drawable/ic_add"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp"
                            app:iconTint="#1A1C1E"
                            app:strokeColor="#5F6368" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_nav_personal"
        app:labelVisibilityMode="labeled" />
</LinearLayout>
