<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imageIcono"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="16dp"
            android:layout_gravity="start"
            app:srcCompat="@drawable/png_clipart_metrostation_teal_cross_icon"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/textVNombreclini"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clinica San Rafael"
            android:textSize="40sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Iniciar sesión"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="20dp" />

                <EditText
                    android:id="@+id/editTextTextEmailAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Correo electrónico"
                    android:inputType="textEmailAddress"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/editTextTextPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:hint="Contraseña"
                    android:inputType="textPassword"
                    android:textSize="18sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/textViewIngresarComo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="INGRESAR COMO"
            android:textColor="#555555"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Opción: Médico -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMedico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp">

                <View
                    android:id="@+id/bgIconMedico"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:drawable/toast_frame"
                    android:backgroundTint="#E2F2ED"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/iconMedico"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:layout_constraintBottom_toBottomOf="@id/bgIconMedico"
                    app:layout_constraintEnd_toEndOf="@id/bgIconMedico"
                    app:layout_constraintStart_toStartOf="@id/bgIconMedico"
                    app:layout_constraintTop_toTopOf="@id/bgIconMedico"
                    app:srcCompat="@android:drawable/ic_menu_call"
                    app:tint="#1E3A34"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/titleMedico"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="10dp"
                    android:text="Médico"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/arrowMedico"
                    app:layout_constraintStart_toEndOf="@id/bgIconMedico"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/descMedico"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="10dp"
                    android:text="Agenda, consulta, diagnóstico y prescripción"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toStartOf="@id/arrowMedico"
                    app:layout_constraintStart_toEndOf="@id/bgIconMedico"
                    app:layout_constraintTop_toBottomOf="@id/titleMedico" />

                <ImageView
                    android:id="@+id/arrowMedico"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@android:drawable/ic_media_play"
                    app:tint="#888888"
                    tools:ignore="ContentDescription" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Opción: Enfermero -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardEnfermero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp">

                <View
                    android:id="@+id/bgIconEnfermero"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:drawable/toast_frame"
                    android:backgroundTint="#E2F2ED"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/iconEnfermero"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:layout_constraintBottom_toBottomOf="@id/bgIconEnfermero"
                    app:layout_constraintEnd_toEndOf="@id/bgIconEnfermero"
                    app:layout_constraintStart_toStartOf="@id/bgIconEnfermero"
                    app:layout_constraintTop_toTopOf="@id/bgIconEnfermero"
                    app:srcCompat="@android:drawable/ic_menu_sort_by_size"
                    app:tint="#1E3A34"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/titleEnfermero"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="10dp"
                    android:text="Enfermero"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/arrowEnfermero"
                    app:layout_constraintStart_toEndOf="@id/bgIconEnfermero"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/descEnfermero"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="10dp"
                    android:text="Signos vitales y administración de medicamentos"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toStartOf="@id/arrowEnfermero"
                    app:layout_constraintStart_toEndOf="@id/bgIconEnfermero"
                    app:layout_constraintTop_toBottomOf="@id/titleEnfermero" />

                <ImageView
                    android:id="@+id/arrowEnfermero"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#888888"
                    tools:ignore="ContentDescription"
                    tools:srcCompat="@android:drawable/ic_media_play" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Opción: Administrativo -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAdministrativo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp">

                <View
                    android:id="@+id/bgIconAdministrativo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:drawable/toast_frame"
                    android:backgroundTint="#E2F2ED"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/iconAdministrativo"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:layout_constraintBottom_toBottomOf="@id/bgIconAdministrativo"
                    app:layout_constraintEnd_toEndOf="@id/bgIconAdministrativo"
                    app:layout_constraintStart_toStartOf="@id/bgIconAdministrativo"
                    app:layout_constraintTop_toTopOf="@id/bgIconAdministrativo"
                    app:srcCompat="@android:drawable/ic_menu_agenda"
                    app:tint="#1E3A34"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/titleAdministrativo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="10dp"
                    android:text="Administrativo"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/arrowAdministrativo"
                    app:layout_constraintStart_toEndOf="@id/bgIconAdministrativo"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/descAdministrativo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="10dp"
                    android:text="Pacientes, citas, facturas y personal"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toStartOf="@id/arrowAdministrativo"
                    app:layout_constraintStart_toEndOf="@id/bgIconAdministrativo"
                    app:layout_constraintTop_toBottomOf="@id/titleAdministrativo" />

                <ImageView
                    android:id="@+id/arrowAdministrativo"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#888888"
                    tools:ignore="ContentDescription"
                    tools:srcCompat="@android:drawable/ic_media_play" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
