<?xml version="1.0" encoding="utf-8"?>
<!-- new Paciente(nombre, apellido, dni, edad, numeroHistoria) + new HistorialMedico() → CentroMedico.registrarPaciente(Paciente) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cm_fondo"
    android:orientation="vertical"
    tools:context=".Registrar_paciente">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/cm_fondo"
        app:title="Registrar paciente"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="Volver"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

    <FrameLayout android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.core.widget.NestedScrollView android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="96dp"
                android:divider="@drawable/espacio_12"
                android:showDividers="middle">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Datos personales"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/cm_texto_secundario" />

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:divider="@drawable/espacio_12"
                    android:showDividers="middle">
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilNombre"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="Nombre">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etNombre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            tools:text="Juan" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilApellido"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="Apellido">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etApellido"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            tools:text="Pérez" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilDni"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="DNI">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etDni"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        tools:text="99887766D" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilEdad"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Edad"
                    app:suffixText="años">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etEdad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        tools:text="55" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Historia clínica"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/cm_texto_secundario" />

                <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilNumeroHistoria"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Número de historia">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etNumeroHistoria"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        tools:text="HC-2024-001" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardInfoHistorial"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/cm_info_contenedor">
                    <TextView android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp"
                        android:drawablePadding="12dp"
                        android:gravity="center_vertical"
                        android:text="Al guardar se crea un historial médico vacío para el paciente."
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        app:drawableStartCompat="@drawable/ic_history"
                        app:drawableTint="@color/cm_info" />
                </com.google.android.material.card.MaterialCardView>

                <Space android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:divider="@drawable/espacio_12"
                    android:showDividers="middle">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnCancelar"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="56dp"
                        android:text="Cancelar" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnRegistrar"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="56dp"
                        android:text="Registrar"
                        app:icon="@drawable/ic_check" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
